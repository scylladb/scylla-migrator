{
  "disableAllHooks": true,
  "env": {
    "GIT_CONFIG_COUNT": "3",
    "GIT_CONFIG_KEY_0": "safe.bareRepository",
    "GIT_CONFIG_VALUE_0": "explicit",
    "GIT_CONFIG_KEY_1": "core.fsmonitor",
    "GIT_CONFIG_VALUE_1": "false",
    "GIT_CONFIG_KEY_2": "core.hooksPath",
    "GIT_CONFIG_VALUE_2": "/dev/null"
  },
  "permissions": {
    "deny": [
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Edit(./**/.git)",
      "Edit(./**/.git/**)",
      "Read(//proc/**)",
      "Read(//home/runner/work/_*/**)",
      "Read(//home/runner/actions-runner/**)",
      "Read(//home/runner/runners/**)",
      "Read(//home/runner/.*)",
      "Read(//home/runner/.*/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.mcp.json)",
      "Edit(./.gitmodules)",
      "Edit(./CLAUDE.md)",
      "Edit(//home/runner/.*)",
      "Edit(//home/runner/.*/**)",
      "Edit(//home/runner/work/_*/**)",
      "Edit(./**/.claude/**)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./**/CLAUDE.local.md)",
      "Edit(./**/AGENTS.md)",
      "Edit(./**/Agents.md)",
      "Edit(./**/agents.md)",
      "Edit(./**/.agents/**)",
      "Edit(./**/.env*)",
      "Edit(./**/bunfig.toml)",
      "Edit(./**/.bunfig.toml)",
      "Edit(./**/.npmrc)",
      "Edit(./.gitattributes)",
      "Edit(./**/.gitattributes)",
      "Edit(./.husky/**)",
      "Edit(./.vscode/**)",
      "Edit(./**/.devcontainer/**)",
      "Edit(./.devcontainer.json)",
      "Edit(./**/.devcontainer.json)",
      "Edit(./.lfsconfig)",
      "Edit(./**/.lfsconfig)",
      "Edit(./**/.cursor/**)",
      "Bash(git *--output*)",
      "Bash(git *--upl*)",
      "Bash(git *--exec*)",
      "Bash(git * -F*)",
      "Bash(git *\"-F*)",
      "Bash(git *'-F*)",
      "Bash(git merge *F/*)",
      "Bash(git *--fil*)",
      "Bash(git *--pathspec-fr*)",
      "Bash(git *--te*)",
      "Bash(git commit * -t*)",
      "Bash(git commit *\"-t*)",
      "Bash(git commit *'-t*)",
      "Bash(git commit */*)",
      "Bash(git *--no-index*)",
      "Bash(git *=/*)",
      "Bash(git * /*)",
      "Bash(git *\"/*)",
      "Bash(git *'/*)",
      "Bash(git *,/*)",
      "Bash(git *.git/*)",
      "Bash(git *../*)",
      "Bash(git * ..)",
      "Bash(git * .. *)",
      "Bash(git *\"..*)",
      "Bash(git *'..*)",
      "Bash(git *=..*)",
      "Bash(git */..*)",
      "Bash(git * ~*)",
      "Bash(git *=~*)",
      "Bash(git *:~*)",
      "Bash(git *{*)",
      "Bash(git *''*)",
      "Bash(git *\"\"*)",
      "Bash(*$*)",
      "Bash(*`*)",
      "Bash(*\\\\*)",
      "Bash(*>*)",
      "Bash(*<*)",
      "Bash(git grep*)",
      "Bash(gh api*)",
      "Bash(gh *--jq*)",
      "Bash(gh *-q*)",
      "Bash(gh *-t*)",
      "Bash(gh *-c*)",
      "Bash(gh *-w*)",
      "Bash(gh *'*)",
      "Bash(gh *\"*)",
      "Bash(gh *{*)",
      "Bash(gh *?*)",
      "Bash(gh *[*)",
      "Bash(gh *\\**)",
      "Bash(gh secret*)",
      "Bash(gh variable*)"
